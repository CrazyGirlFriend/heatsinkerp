{
  "name": "heatsink-flow-frontend",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vue-tsc -b && vite build",
    "preview": "vite preview",
    "typecheck": "vue-tsc -b --pretty false",
    "api:generate": "node scripts/generate-api-types.mjs",
    "api:check": "node scripts/generate-api-types.mjs --check",
    "test": "vitest run",
    "lint": "eslint src --max-warnings=0",
    "format:check": "node scripts/check-format.mjs",
    "format": "node scripts/check-format.mjs --write"
  },
  "dependencies": {
    "@element-plus/icons-vue": "^2.3.2",
    "@tabler/icons-vue": "3.49.0",
    "@visactor/vtable": "1.26.8",
    "@visactor/vtable-gantt": "1.26.8",
    "axios": "^1.20.0",
    "dayjs": "1.11.23",
    "docx-preview": "0.4.1",
    "echarts": "^6.1.0",
    "element-plus": "^2.14.5",
    "exceljs": "4.4.0",
    "jsbarcode": "^3.12.1",
    "motion-v": "^2.10.0",
    "pinia": "^4.0.3",
    "vue": "^3.5.13",
    "vue-router": "^4.5.0",
    "write-excel-file": "4.1.1"
  },
  "overrides": {
    "@visactor/vtable": {
      "lodash": "4.18.1"
    },
    "geojson-flatten": {
      "minimist": "1.2.8"
    }
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@types/jsbarcode": "^3.11.4",
    "@vitejs/plugin-vue": "^5.2.1",
    "@vue/test-utils": "^2.4.6",
    "eslint": "10.11.0",
    "eslint-plugin-vue": "10.11.0",
    "jsdom": "^25.0.1",
    "openapi-typescript": "7.13.0",
    "prettier": "3.9.8",
    "typescript": "~5.7.2",
    "typescript-eslint": "8.70.0",
    "vite": "^6.0.5",
    "vitest": "^2.1.8",
    "vue-eslint-parser": "10.4.1",
    "vue-tsc": "^2.2.0"
  }
}
