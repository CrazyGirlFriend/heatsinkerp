APP_NAME=Heat Sink Production Flow API
APP_ENV=production
MYSQL_HOST=127.0.0.1
MYSQL_PORT=3306
MYSQL_DATABASE=heatsink_rep
MYSQL_USER=heatsink
MYSQL_PASSWORD=change-me
CORS_ORIGINS=http://localhost:5173
AUTO_CREATE_TABLES=false
SESSION_TTL_HOURS=24
FACTORY_TIMEZONE=Asia/Shanghai
SEED_ADMIN_USERNAME=admin
SEED_ADMIN_PASSWORD=change-this-before-production
SEED_ADMIN_DISPLAY_NAME=系统管理员
# Leave password empty to disable the optional site-access gate locally.
SITE_ACCESS_PASSWORD=
# Required when the gate is enabled: use a random secret of at least 32 bytes.
SITE_ACCESS_SECRET=
SITE_ACCESS_SECURE_COOKIE=false

# Optional read-only company-system integration. Empty URL keeps it disabled.
MAIN_SYSTEM_BASE_URL=
MAIN_SYSTEM_TOKEN=
MAIN_SYSTEM_TIMEOUT_SECONDS=5
MAIN_SYSTEM_CONFIG_KEY=
MAIN_SYSTEM_ALLOWED_ORIGINS=
