MYSQL_DATABASE=heatsink_rep
MYSQL_USER=heatsink
MYSQL_PASSWORD=change_me
MYSQL_ROOT_PASSWORD=change_root_me
MYSQL_PORT=3306
BACKEND_PORT=8000
FRONTEND_PORT=8080
SESSION_TTL_HOURS=24
FACTORY_TIMEZONE=Asia/Shanghai
SEED_ADMIN_USERNAME=admin
SEED_ADMIN_PASSWORD=change_this_before_production
SEED_ADMIN_DISPLAY_NAME=系统管理员

# Optional local access gate. Server deployment requires both values.
SITE_ACCESS_PASSWORD=
# Generate with: openssl rand -hex 32
SITE_ACCESS_SECRET=
SITE_ACCESS_SECURE_COOKIE=false

# Server-to-server serial-material lookup; never place this token in VITE_*.
MAIN_SYSTEM_BASE_URL=
MAIN_SYSTEM_TOKEN=
MAIN_SYSTEM_TIMEOUT_SECONDS=5
# Generate once with Fernet.generate_key(); keep outside the database/repository.
MAIN_SYSTEM_CONFIG_KEY=
# Comma-separated HTTPS origins allowed for administrator configuration.
MAIN_SYSTEM_ALLOWED_ORIGINS=
